# Analysis flow: "trufflehog-only" | "llm-only" | "hybrid"
FLOW=hybrid

# Self-hosted OpenAI-compatible AI Gateway settings.
# Required for llm-only and for hybrid when LLM_CONTEXT_CLASSIFIER_ENABLED=true.
AI_GATEWAY_URL=https://ai-gateway.internal.example
AI_GATEWAY_MODEL=security-context-model
# Optional when the gateway authenticates with mTLS or workload identity.
AI_GATEWAY_AUTH_TOKEN=your-gateway-token-here
AI_GATEWAY_TIMEOUT_SECONDS=30

# Optional per-million-token prices for this model. Cost is reported as n/a
# when input/output prices are omitted. Cached input defaults to input price.
# AI_GATEWAY_INPUT_COST_PER_MILLION_USD=1.25
# AI_GATEWAY_OUTPUT_COST_PER_MILLION_USD=10.00
# AI_GATEWAY_CACHED_INPUT_COST_PER_MILLION_USD=0.125

# Contextual classification and review-only detector advice.
LLM_CONTEXT_CLASSIFIER_ENABLED=true
LLM_DETECTOR_ADVISOR_ENABLED=false
LLM_MAX_CONTEXT_EXPANSIONS=2
LLM_MAX_CONTEXT_LINES=150
LLM_PROMPT_PROFILE=context-classifier-v1
LLM_DETECTOR_PROMPT_PROFILE=detector-advisor-v1

MAX_TOKENS_PER_REQUEST=4096
MAX_LLM_CALLS_PER_FILE=3

# GitHub source control (required)
# Supports one or more comma-separated PATs for a combined rate-limit pool:
# GITHUB_PAT=ghp_token1,ghp_token2
GITHUB_PAT=your-github-personal-access-token-here

# Maximum number of defer-and-retry passes when all GitHub PATs hit their rate limit.
# Each retry waits for the earliest token's reset window (up to 1 hour). Default: 2.
# GITHUB_RATE_LIMIT_MAX_RETRIES=2

# Azure DevOps source control (optional — only needed for Azure DevOps SCM links)
# AZURE_DEVOPS_PAT=your-azure-devops-pat-here

# TruffleHog scanner controls (optional)
# Verification mode: "all" (default) | "no-verification"
TRUFFLEHOG_VERIFICATION_MODE=all
# Scanner subprocess timeout in seconds (default: 60)
TRUFFLEHOG_TIMEOUT_SECONDS=60
# Custom User-Agent suffix appended to TruffleHog HTTP verification requests (e.g. for audit logs)
# TRUFFLEHOG_USER_AGENT_SUFFIX=SecurityTeamAudit-2026
# Optional YAML file containing custom TruffleHog detectors and verifiers
# TRUFFLEHOG_CONFIG_PATH=/etc/trufflehog/custom.yaml

# Concurrency and limits
CONCURRENCY=5
MAX_FILE_SIZE_KB=500
SURROUNDING_LINES=10

# Filtering and batch limits (optional)
# Comma-separated list of Check IDs / Rule IDs to reconcile (e.g. CKV_SECRET_6,CKV_AWS_1)
# CHECK_IDS=CKV_SECRET_6,CKV_AWS_1
# Maximum number of pending findings to process in this run (e.g. 100)
# LIMIT=100

# Cleanup temporary files after processing
CLEANUP_TEMP_FILES=true

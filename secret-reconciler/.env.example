# ==============================================================================
# SECRET-RECONCILER CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PIPELINE & SCM SETTINGS (All Flows)
# ------------------------------------------------------------------------------

# Kaunsa analysis mode chalana hai: "trufflehog-only" | "llm-only" | "hybrid"
FLOW=hybrid

# GitHub token (ek ya multiple comma-separated token rotation ke liye). [Used in: All Flows]
GITHUB_PAT=your-github-personal-access-token-here

# GitHub rate limit aane par kitni baar wait karke retry kare (0 to 2). [Used in: All Flows]
# GITHUB_RATE_LIMIT_MAX_RETRIES=2

# Azure DevOps token (agar SCM links Azure ke hain toh zaroori hai). [Used in: All Flows]
# AZURE_DEVOPS_PAT=your-azure-devops-pat-here

# Kitni files parallel mein process hongi (Default: 5). [Used in: All Flows]
CONCURRENCY=5

# Maximum file size in KB. Isse badi file LLM ko nahi bhejte (Default: 500). [Used in: All Flows]
MAX_FILE_SIZE_KB=500

# Run khatam hone par tmp/ folder ki files delete karni hain (true) ya cache rakhna hai (false). [Used in: All Flows]
CLEANUP_TEMP_FILES=true

# Sirf specific Check / Rule IDs process karne ke liye filter (Optional). [Used in: All Flows]
# CHECK_IDS=CKV_SECRET_6,CKV_AWS_1

# Total kitne pending findings process karne hain is run mein (Optional). [Used in: All Flows]
# LIMIT=100


# ------------------------------------------------------------------------------
# 2. TRUFFLEHOG SCANNER SETTINGS (Flow: trufflehog-only & hybrid)
# ------------------------------------------------------------------------------

# Secret live verify kare ("all") ya sirf pattern match kare ("no-verification"). [Used in: TruffleHog & Hybrid]
TRUFFLEHOG_VERIFICATION_MODE=all

# TruffleHog scan execution timeout seconds mein (1 to 60, Default: 60). [Used in: TruffleHog & Hybrid]
TRUFFLEHOG_TIMEOUT_SECONDS=60

# Verification HTTP requests mein custom audit identification suffix (Optional). [Used in: TruffleHog & Hybrid]
# TRUFFLEHOG_USER_AGENT_SUFFIX=SecurityTeamAudit-2026

# Custom TruffleHog detector/verifier rules YAML file ka path (Optional). [Used in: TruffleHog & Hybrid]
# TRUFFLEHOG_CONFIG_PATH=/path/to/custom-rules.yaml


# ------------------------------------------------------------------------------
# 3. AI GATEWAY & LLM CLASSIFIER SETTINGS (Flow: llm-only & hybrid)
# ------------------------------------------------------------------------------

# Self-hosted OpenAI-compatible AI Gateway ka base URL. [Required for: LLM & Hybrid]
AI_GATEWAY_URL=https://ai-gateway.internal.example

# Analysis ke liye LLM model name. [Required for: LLM & Hybrid]
AI_GATEWAY_MODEL=security-context-model

# Gateway auth bearer token (agar mTLS na ho toh). [Optional for: LLM & Hybrid]
AI_GATEWAY_AUTH_TOKEN=your-gateway-token-here

# LLM API request timeout seconds mein (1 to 30, Default: 30). [Used in: LLM & Hybrid]
AI_GATEWAY_TIMEOUT_SECONDS=30

# Gateway prompt caching key aur retention policy ("in_memory" | "24h") (Optional). [Used in: LLM & Hybrid]
# AI_GATEWAY_PROMPT_CACHE_KEY=secret-reconciler
# AI_GATEWAY_PROMPT_CACHE_RETENTION=in_memory

# LLM token pricing estimates USD per million tokens (Optional cost calculation). [Used in: LLM & Hybrid]
# AI_GATEWAY_INPUT_COST_PER_MILLION_USD=1.25
# AI_GATEWAY_OUTPUT_COST_PER_MILLION_USD=10.00
# AI_GATEWAY_CACHED_INPUT_COST_PER_MILLION_USD=0.125

# Code context dekhkar LLM classification enable/disable karna (true | false). [Used in: LLM & Hybrid]
LLM_CONTEXT_CLASSIFIER_ENABLED=true

# Review-only detector advice generator (true | false, Default: false). [Used in: Hybrid]
LLM_DETECTOR_ADVISOR_ENABLED=false

# Secret line ke upar aur niche kitni code lines context mein leni hain (0 to 10, Default: 10). [Used in: LLM & Hybrid]
SURROUNDING_LINES=10

# Agar context chhota lage toh kitni baar expand kare (0 to 2, Default: 2). [Used in: LLM & Hybrid]
LLM_MAX_CONTEXT_EXPANSIONS=2

# Maximum total context lines jo LLM ko bheji ja sakti hain (1 to 150, Default: 150). [Used in: LLM & Hybrid]
LLM_MAX_CONTEXT_LINES=150

# In file path patterns ko LLM analysis se ignore/skip karna (Optional). [Used in: LLM & Hybrid]
# LLM_IGNORE_PATTERNS=*.min.js,*.min.css,node_modules/,*.log

# LLM prompt profiles select karne ke liye. [Used in: LLM & Hybrid]
LLM_PROMPT_PROFILE=context-classifier-v2
LLM_DETECTOR_PROMPT_PROFILE=detector-advisor-v1

# Max output tokens per LLM request. [Required for: LLM & Hybrid]
MAX_TOKENS_PER_REQUEST=4096

# Ek single file ke liye maximum kitni baar LLM call ho sakta hai. [Required for: LLM & Hybrid]
MAX_LLM_CALLS_PER_FILE=3

# Analysis flow: "trufflehog-only" | "llm-only" | "hybrid"
FLOW=hybrid

# Anthropic LLM settings (required when FLOW includes LLM)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS_PER_REQUEST=4096
MAX_LLM_CALLS_PER_FILE=3

# GitHub source control (required)
GITHUB_PAT=your-github-personal-access-token-here

# Azure DevOps source control (optional — only needed for Azure DevOps SCM links)
# AZURE_DEVOPS_PAT=your-azure-devops-pat-here

# TruffleHog scanner controls (optional)
# Verification mode: "all" (default) | "verified-only" | "no-verification"
TRUFFLEHOG_VERIFICATION_MODE=all
# Scanner subprocess timeout in seconds (default: 60)
TRUFFLEHOG_TIMEOUT_SECONDS=60
# Custom User-Agent suffix appended to TruffleHog HTTP verification requests (e.g. for audit logs)
# TRUFFLEHOG_USER_AGENT_SUFFIX=SecurityTeamAudit-2026

# Concurrency and limits
CONCURRENCY=5
MAX_FILE_SIZE_KB=500
SURROUNDING_LINES=10

# Cleanup temporary files after processing
CLEANUP_TEMP_FILES=true
